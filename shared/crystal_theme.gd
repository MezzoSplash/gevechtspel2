class_name CrystalTheme
extends RefCounted
## Turns res://ui/menu_theme.tres into the crystal look (docs/ui-crystal/HANDOFF.md 4.2) at startup.
##
## The .tres stays generated by tools/build_ui_theme.gd with plain StyleBoxFlats; this swaps those
## for CrystalStyle shards in memory, keeping each slot's content margins, and recolours the amber
## accent to ice. Done from code because a script StyleBox inside a generated .tres is untested.
## The patched Theme is held in a static var, so the resource cache keeps returning this same
## instance to menu.tscn, pause.tscn and settings_panel.gd (all `load` the path).
##
## Game._ready() calls install(). Cheap (a few dozen resources), so it also runs on a dedicated
## server: is_dedicated is only known later, in main.gd, and a server never draws a menu anyway.

const PATH := "res://ui/menu_theme.tres"

const SMOKE := CrystalStyle.SMOKE
const SMOKE_HOT := Color(0.11, 0.14, 0.18, 0.80)
const SMOKE_FAINT := Color(0.059, 0.078, 0.106, 0.30)
const SMOKE_PANEL := Color(0.059, 0.078, 0.106, 0.84)
const SMOKE_POPUP := Color(0.045, 0.06, 0.08, 0.97)
const SHELL := CrystalStyle.SHELL
const SHELL_DOWN := Color(0.78, 0.82, 0.86, 0.96)
const ICE := CrystalStyle.ICE
const DARK_TEXT := Color(0.07, 0.08, 0.10)
const TEXT := Color(0.92, 0.94, 0.96)

## Chamfers [tl, tr, br, bl]. Unequal on purpose; small controls get a smaller cut.
const CUTS_BIG := Vector4(14, 6, 18, 8)
const CUTS_MID := Vector4(10, 4, 12, 6)
const CUTS_SMALL := Vector4(6, 3, 7, 4)

static var _theme: Theme


## Patches the menu theme once and returns it. Later calls return the same instance.
static func install() -> Theme:
	if _theme != null:
		return _theme
	var t := load(PATH) as Theme
	if t == null:
		push_warning("CrystalTheme: %s missing" % PATH)
		return null
	_buttons(t)
	_primary(t)
	_menu_big(t)
	_chips(t)
	_fields(t)
	_popups(t)
	_panels(t)
	_type(t)
	_theme = t
	return t


## A shard that takes the content margins of the slot it replaces.
static func _shard(t: Theme, state: String, type: String, fill: Color, cuts: Vector4, variant: int) -> CrystalStyle:
	var s := CrystalStyle.new()
	var old := t.get_stylebox(state, type) if t.has_stylebox(state, type) else null
	if old != null:
		for side in [SIDE_LEFT, SIDE_TOP, SIDE_RIGHT, SIDE_BOTTOM]:
			s.set_content_margin(side, old.get_content_margin(side))
	s.fill = fill
	s.cuts = cuts
	s.variant = variant
	return s


static func _seam(s: CrystalStyle, side: int, color := ICE, lit := 1.0) -> CrystalStyle:
	s.seam_side = side
	s.seam_color = color
	s.seam_lit = lit
	return s


static func _pale(s: CrystalStyle) -> CrystalStyle:
	s.pale = true
	s.edge_alpha = 0.0
	return s


## Focus ring: the outline only, drawn over whatever state the control is in.
static func _ring(t: Theme, type: String, cuts: Vector4, alpha := 0.55) -> CrystalStyle:
	var s := _shard(t, "focus", type, Color(0, 0, 0, 0), cuts, 1)
	s.facet_strength = 0.0
	s.edge_alpha = alpha
	return s


static func _buttons(t: Theme) -> void:
	for type in ["Button", "OptionButton"]:
		var cuts := CUTS_MID
		t.set_stylebox("normal", type, _shard(t, "normal", type, SMOKE, cuts, 2))
		t.set_stylebox("hover", type, _seam(_shard(t, "hover", type, SMOKE_HOT, cuts, 2), CrystalStyle.Side.LEFT))
		t.set_stylebox("pressed", type, _seam(_pale(_shard(t, "pressed", type, SHELL, cuts, 2)), CrystalStyle.Side.LEFT))
		t.set_stylebox("hover_pressed", type, _seam(_pale(_shard(t, "hover_pressed", type, SHELL, cuts, 2)), CrystalStyle.Side.LEFT))
		var off := _shard(t, "disabled", type, SMOKE_FAINT, cuts, 2)
		off.facet_strength = 0.4
		off.edge_alpha = 0.06
		t.set_stylebox("disabled", type, off)
		t.set_stylebox("focus", type, _seam(_ring(t, type, cuts), CrystalStyle.Side.LEFT)) # pad/keyboard: ring + seam
		t.set_color("font_pressed_color", type, DARK_TEXT)
		t.set_color("font_hover_pressed_color", type, DARK_TEXT)
	# CheckBox keeps its clear slab (rows draw the background); only the focus ring changes.
	t.set_stylebox("focus", "CheckBox", _ring(t, "CheckBox", CUTS_SMALL))


static func _primary(t: Theme) -> void:
	var type := "PrimaryButton"
	t.set_stylebox("normal", type, _pale(_shard(t, "normal", type, SHELL, CUTS_BIG, 3)))
	t.set_stylebox("hover", type, _seam(_pale(_shard(t, "hover", type, SHELL, CUTS_BIG, 3)), CrystalStyle.Side.LEFT))
	t.set_stylebox("pressed", type, _pale(_shard(t, "pressed", type, SHELL_DOWN, CUTS_BIG, 3)))
	t.set_stylebox("focus", type, _seam(_ring(t, type, CUTS_BIG, 0.8), CrystalStyle.Side.LEFT))


static func _menu_big(t: Theme) -> void:
	var type := "MenuButtonBig"
	var normal := _shard(t, "normal", type, SMOKE, CUTS_BIG, 4)
	_seam(normal, CrystalStyle.Side.LEFT, Color(ICE, 0.55), 0.4) # the dim pip of an idle row
	t.set_stylebox("normal", type, normal)
	for st in ["hover", "hover_pressed", "focus"]:
		t.set_stylebox(st, type, _seam(_pale(_shard(t, st, type, SHELL, CUTS_BIG, 4)), CrystalStyle.Side.LEFT))
	t.set_stylebox("pressed", type, _seam(_pale(_shard(t, "pressed", type, SHELL_DOWN, CUTS_BIG, 4)), CrystalStyle.Side.LEFT))
	t.set_color("font_color", type, TEXT)
	t.set_color("font_hover_color", type, DARK_TEXT)
	t.set_color("font_focus_color", type, DARK_TEXT)
	t.set_color("font_pressed_color", type, DARK_TEXT)
	t.set_color("font_hover_pressed_color", type, DARK_TEXT)


static func _chips(t: Theme) -> void:
	var type := "ChoiceChip"
	t.set_stylebox("normal", type, _shard(t, "normal", type, SMOKE, CUTS_SMALL, 5))
	t.set_stylebox("hover", type, _seam(_shard(t, "hover", type, SMOKE_HOT, CUTS_SMALL, 5), CrystalStyle.Side.BOTTOM))
	t.set_stylebox("pressed", type, _seam(_pale(_shard(t, "pressed", type, SHELL, CUTS_SMALL, 5)), CrystalStyle.Side.BOTTOM))
	t.set_stylebox("hover_pressed", type, _seam(_pale(_shard(t, "hover_pressed", type, SHELL, CUTS_SMALL, 5)), CrystalStyle.Side.BOTTOM))
	var off := _shard(t, "disabled", type, SMOKE_FAINT, CUTS_SMALL, 5)
	off.facet_strength = 0.3
	off.edge_alpha = 0.05
	t.set_stylebox("disabled", type, off)
	t.set_stylebox("focus", type, _ring(t, type, CUTS_SMALL, 0.8))


static func _fields(t: Theme) -> void:
	var le := _shard(t, "normal", "LineEdit", SMOKE, CUTS_SMALL, 6)
	le.facet_strength = 0.5
	t.set_stylebox("normal", "LineEdit", le)
	t.set_stylebox("read_only", "LineEdit", le)
	t.set_stylebox("focus", "LineEdit", _seam(_ring(t, "LineEdit", CUTS_SMALL), CrystalStyle.Side.BOTTOM))
	t.set_color("caret_color", "LineEdit", ICE)
	t.set_color("selection_color", "LineEdit", Color(ICE, 0.35))
	# Sliders stay thin flat bars (a 6 px shard has nothing to facet); the fill glows ice.
	_recolor_flat(t, "grabber_area", "HSlider", ICE)
	_recolor_flat(t, "grabber_area_highlight", "HSlider", Color.WHITE)
	# Mockup settings.png: a glowing fill and a diamond grabber, pale on dark rows.
	for st in ["grabber_area", "grabber_area_highlight"]:
		var g := t.get_stylebox(st, "HSlider") as StyleBoxFlat if t.has_stylebox(st, "HSlider") else null
		if g != null:
			g.shadow_color = Color(ICE, 0.45)
			g.shadow_size = 5
	t.set_icon("grabber", "HSlider", diamond(18, Color(0.93, 0.96, 1.0)))
	t.set_icon("grabber_highlight", "HSlider", diamond(20, Color.WHITE))
	t.set_icon("grabber_disabled", "HSlider", diamond(18, Color(0.5, 0.55, 0.6)))
	var sf := t.get_stylebox("focus", "HSlider") as StyleBoxFlat
	if sf != null:
		sf.border_color = Color(ICE, 0.7)
	_recolor_flat(t, "grabber_highlight", "VScrollBar", Color(ICE, 0.8))
	_recolor_flat(t, "grabber_pressed", "VScrollBar", Color(ICE, 0.8))


static func _popups(t: Theme) -> void:
	t.set_stylebox("panel", "PopupMenu", _shard(t, "panel", "PopupMenu", SMOKE_POPUP, CUTS_MID, 7))
	t.set_stylebox("hover", "PopupMenu", _seam(_shard(t, "hover", "PopupMenu", SMOKE_HOT, CUTS_SMALL, 7), CrystalStyle.Side.LEFT))


static func _panels(t: Theme) -> void:
	var mp := _shard(t, "panel", "MenuPanel", SMOKE_PANEL, CUTS_BIG, 8)
	mp.facet_strength = 0.5
	t.set_stylebox("panel", "MenuPanel", _seam(mp, CrystalStyle.Side.TOP, ICE, 0.18))
	var pc := _shard(t, "panel", "PanelContainer", SMOKE_PANEL, CUTS_BIG, 9)
	pc.facet_strength = 0.5
	t.set_stylebox("panel", "PanelContainer", pc)
	var row := _shard(t, "panel", "SettingRow", Color(SMOKE, 0.35), CUTS_SMALL, 10)
	row.facet_strength = 0.35
	row.edge_alpha = 0.07
	t.set_stylebox("panel", "SettingRow", row)


## Type: same faces, wider tracking, no amber. The FontVariations are shared between types, so
## each one is widened once.
static func _type(t: Theme) -> void:
	t.set_color("font_color", "SectionLabel", ICE)
	t.set_color("font_pressed_color", "OptionButton", DARK_TEXT)
	var seen := {}
	for pair in [["font", "Button"], ["font", "TitleLabel"]]:
		var f := t.get_font(pair[0], pair[1]) as FontVariation
		if f == null or seen.has(f):
			continue
		seen[f] = true
		f.spacing_glyph += 1


static func _recolor_flat(t: Theme, state: String, type: String, c: Color) -> void:
	var sb := t.get_stylebox(state, type) as StyleBoxFlat if t.has_stylebox(state, type) else null
	if sb != null:
		sb.bg_color = c


## A diamond (square on its point) with a soft 1 px edge, `px` wide: the slider grabber.
static func diamond(px: int, col: Color) -> ImageTexture:
	var img := Image.create(px, px, false, Image.FORMAT_RGBA8)
	var c := (px - 1) * 0.5
	for y in px:
		for x in px:
			# Manhattan distance is the diamond; 1 px of falloff anti-aliases the edge.
			var d := absf(x - c) + absf(y - c)
			var a := clampf(c - d + 0.5, 0.0, 1.0)
			var shade := col.darkened(0.25) if y > c else col
			img.set_pixel(x, y, Color(shade, a))
	return ImageTexture.create_from_image(img)
